# PermitForge — environment template.
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local` (it is gitignored).

# ── Supabase ─────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── Google Gemini ────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key

# ── JWT Auth (min 32 chars, 64+ recommended for production) ─
JWT_SECRET=your_secure_random_jwt_secret

# ── Email via Nodemailer / Gmail SMTP (optional) ─────────
SMTP_HOST=smtp.gmail.com                 # SMTP server host
SMTP_PORT=587                            # SMTP port (587 for TLS, 465 for SSL)
SMTP_USER=your_gmail@gmail.com           # Gmail address
SMTP_PASS=your_app_password              # Gmail App Password (16 chars)

# ── Logging (optional) ───────────────────────────────────
LOG_LEVEL=info                           # debug | info | warn | error

# ── Advanced / optional ──────────────────────────────────
# Required only when ENABLE_USER_CONTEXT_RLS=1 (must match the
# project's Supabase JWT secret); unused when the flag is off.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret
# Set to 1 to route user-context reads through the anon key + minted
# JWT so RLS engages as defense-in-depth. Default: off.
ENABLE_USER_CONTEXT_RLS=0
# Local-dev only: set to 1 to drop the Secure cookie flag so cookies
# survive plain-HTTP localhost.
DEV_INSECURE_COOKIES=0
# Override the chat model (default gemini-2.5-flash) for A/B testing.
GEMINI_MODEL_CHAT=gemini-2.5-flash
# Override the embedding model (default gemini-embedding-001).
# Changing this requires re-ingesting all documents.
GEMINI_MODEL_EMBED=gemini-embedding-001
